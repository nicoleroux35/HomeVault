# HomeVaultOS — preinstalled package set (Debian 12 / bookworm).
#
# This mirrors what installer/install.sh installs on a plain Debian/Ubuntu
# system, plus the live-boot stack and the self-install tooling. The ISO is
# "ready to use": nothing is downloaded at boot. Trim lines freely to shrink
# the image (docs/guides/os-image.md lists what each group buys you).

# --- live system ----------------------------------------------------------
linux-image-amd64
live-boot
live-boot-initramfs-tools
live-config
live-config-systemd
systemd-sysv

# --- firmware (NAS hardware: NICs, WiFi, storage controllers) -------------
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-atheros
firmware-iwlwifi
firmware-brcm80211

# --- self-install tooling (variant B flashes a prebuilt image; the image
# itself is baked at build time by os/build-disk-image.sh, which runs
# grub-install from inside a chroot of the image — needs the image to carry
# the full GRUB toolchain) ------------------------------
grub2-common
grub-efi-amd64-bin
grub-pc-bin
gdisk
efibootmgr
parted
dosfstools
e2fsprogs
rsync
squashfs-tools

# --- networking -----------------------------------------------------------
network-manager
avahi-daemon
libnss-mdns

# --- HomeVault base dependencies (required group of install.sh) -----------
sudo
build-essential
pkg-config
libsqlite3-dev
sqlite3
wget
curl
ca-certificates
git
python3
acl
quota
smartmontools
mdadm
gnupg
iproute2
util-linux
lsb-release
lm-sensors
udisks2
udiskie
dmidecode
ethtool
iputils-ping
ffmpeg

# --- archive + hardware helpers ------------------------------------------
unzip
zip
pciutils
hostname
7zip
aria2

# --- security -------------------------------------------------------------
clamav
clamav-freshclam
ufw
cryptsetup

# --- sharing --------------------------------------------------------------
samba
nfs-kernel-server
vsftpd
openssh-server

# --- VPN ------------------------------------------------------------------
wireguard-tools
openvpn

# --- mounting (rclone + removable drives; udisks2/udiskie are in the base
# group above) -------------------------------------------------------------
fuse3
# fuse3 ships the `/bin/fusermount -> fusermount3` compat symlink the app's
# rclone unmount path calls (src/handlers/rclone.rs); the real fuse2 package
# `Breaks: fuse` against fuse3 and cannot be coinstalled on bookworm.
ntfs-3g
exfat-fuse

# --- rescue ---------------------------------------------------------------
gddrescue
testdisk

# --- backup / sync --------------------------------------------------------
restic
syncthing

# --- storage pools --------------------------------------------------------
zfsutils-linux
btrfs-progs

# --- containers / VMs -----------------------------------------------------
docker.io
# NOTE: the whole VM stack (incus + qemu + swtpm + ovmf) is installed by hook
# 0100-docker-vm-stack.chroot from bookworm-backports, NOT here: incus from
# backports requires qemu-system-x86 (>= 1:8.0) while the stable candidate is
# 7.2, and listing both sources top-level mixes versions and breaks apt.
# virtiofsd does not exist as a package in Debian 12 at all (the app never
# checks for it — src/dependencies.rs); install.sh requests it only where the
# repos carry it (Ubuntu 24.04+, Debian 13+).

# --- monitoring -----------------------------------------------------------
snmpd
snmp
nut
