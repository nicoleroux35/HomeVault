#!/bin/bash
set -e

# HomeVaultOS chroot hook — repositories that carry packages missing from the
# Debian archive:
#   * docker-compose-plugin → official Docker repository (the Compose tab of
#     the Docker app needs the v2 plugin; Debian never ships it)
#   * incus                 → bookworm-backports (Virtual Machines app)
# Everything here is best-effort: a failure disables the feature at runtime
# (src/dependencies.rs degrades cleanly) but must not break the image build.

. /etc/os-release
DEBIAN_FRONTEND=noninteractive
export DEBIAN_FRONTEND

echo "[hv-os] Adding the official Docker repository (docker-compose-plugin)…"
install -m 0755 -d /etc/apt/keyrings
curl -fsSL "https://download.docker.com/linux/${ID}/gpg" \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" \
    > /etc/apt/sources.list.d/docker.list

apt-get update -qq

if apt-get install -y --no-install-recommends docker-compose-plugin; then
    echo "[hv-os] ✓ docker-compose-plugin"
else
    echo "[hv-os] WARNING: docker-compose-plugin unavailable — Compose tab disabled"
fi

echo "[hv-os] Installing incus + the QEMU/VM stack from ${VERSION_CODENAME}-backports…"
# One consistent source: incus from backports depends on qemu-system-x86
# (>= 1:8.0) while the bookworm stable candidate is 7.2 — installing the whole
# stack with -t backports keeps every qemu binary at the same version.
# swtpm/ovmf ride along (backports version when present, stable otherwise).
if apt-get install -y --no-install-recommends \
        -t "${VERSION_CODENAME}-backports" \
        incus qemu-system-x86 qemu-system-modules-spice swtpm swtpm-tools ovmf; then
    systemctl enable incus >/dev/null 2>&1 || true
    echo "[hv-os] ✓ incus + QEMU VM stack (Virtual Machines app)"
elif apt-get install -y --no-install-recommends \
        incus qemu-system-x86 swtpm swtpm-tools ovmf; then
    systemctl enable incus >/dev/null 2>&1 || true
    echo "[hv-os] ✓ incus + QEMU (backports unavailable — SPICE module missing, VM display degraded)"
else
    echo "[hv-os] WARNING: incus unavailable — Virtual Machines app disabled"
fi
