[Unit]
Description=HomeVault Server
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/homevault
ExecStart=/opt/homevault/homevault
Restart=on-failure
RestartSec=5
Environment="PORT=8080"
Environment="DATA_DIRECTORY=/var/lib/homevault"
# Built-in HTTPS is opt-in (Settings > Security > HTTPS/TLS, or set
# TLS_ENABLED=true here / in /etc/homevault.env). When enabled, HomeVault
# adds a TLS listener on HTTPS_PORT (default 8443) alongside HTTP.
#Environment="TLS_ENABLED=true"
#Environment="HTTPS_PORT=8443"
EnvironmentFile=-/etc/homevault.env

# Resource ceiling (same values as installer/install.sh).
MemoryHigh=1536M
MemoryMax=2G
TasksMax=1024

[Install]
WantedBy=multi-user.target
