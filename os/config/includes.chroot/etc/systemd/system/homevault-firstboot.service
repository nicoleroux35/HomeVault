[Unit]
Description=HomeVaultOS first-boot provisioning (data volume, optional self-install)
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service systemd-remount-fs.service
Before=homevault.service docker.service udiskie.service multi-user.target
ConditionPathExists=/usr/local/sbin/hv-firstboot

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hv-firstboot
RemainAfterExit=yes
# Cloning the system onto disk (variant B) can take several minutes.
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
