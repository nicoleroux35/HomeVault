{
  "name": "homevault-frontend",
  "private": true,
  "description": "HomeVault web interface — Svelte 5 desktop-style UI, served by the Rust backend",
  "version": "1.0.0",
  "author": "Nicolas Le Roux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicoleroux35/HomeVault.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/nicoleroux35/HomeVault",
  "type": "module",
  "browserslist": [
    "defaults",
    "Safari >= 15",
    "iOS >= 15",
    "Firefox ESR"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/precompress-dist.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:ui": "node scripts/lint-i18n.mjs && node scripts/lint-tokens.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.9",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.5.0",
    "deepmerge": "file:./vendor/deepmerge",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.29.3",
    "postcss": "^8.5.32",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.71.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "layerchart": "^2.5.2",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
