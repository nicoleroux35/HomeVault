        <div class="card-header">Title</div>
        <div class="card-body">Content</div>
      </div>",
  "<div class="card">
        <div class="card-header">Another Card</div>
        <div class="card-body">More content</div>
      </div>",
]
`;

exports[`Desktop screen snapshots > renders desktop with open windows 1`] = `
"
      <div class="hv-desktop">
        <div class="hv-topbar"></div>
        <div class="hv-window" data-app="settings">
          <div class="hv-window-header">
            <h1>Settings</h1>
          </div>
          <div class="hv-window-body">
            <!-- Settings content -->
          </div>
        </div>
        <div class="hv-dock"></div>
      </div>
    "
`;

exports[`Desktop screen snapshots > renders empty desktop 1`] = `
"
      <div class="hv-desktop" data-testid="hv-desktop">
        <div class="hv-topbar"></div>
        <div class="hv-dock">
          <div class="hv-dock-icon" data-app="settings"></div>
          <div class="hv-dock-icon" data-app="explorer"></div>
        </div>
      </div>
    "
`;

exports[`Login screen snapshots > renders 2FA verification screen 1`] = `
"
      <div class="login-container">
        <form>
          <h1>Two-Factor Authentication</h1>
          <p>Enter the 6-digit code from your authenticator app</p>
          <div class="totp-inputs">
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
          </div>
          <button type="submit">Verify</button>
        </form>
      </div>
    "
`;

exports[`Login screen snapshots > renders login form 1`] = `
"
      <div class="login-container">
        <form>
          <h1>Sign In</h1>
          <input type="text" name="username" placeholder="Username" />
          <input type="password" name="password" placeholder="Password" />
          <button type="submit">Sign In</button>
        </form>
      </div>
    "
`;

exports[`Login screen snapshots > renders login form with error 1`] = `
"
      <div class="login-container">
        <form>
          <h1>Sign In</h1>
          <div class="alert error">Invalid credentials</div>
          <input type="text" name="username" placeholder="Username" />
          <input type="password" name="password" placeholder="Password" />
          <button type="submit">Sign In</button>
        </form>
      </div>
    "
`;

