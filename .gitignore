.claude/settings.local.json
.claude/worktrees/

# design-sync (claude.ai/design) build output + scratch
/ds-bundle/
/.ds-sync/
/.design-sync/

# Local design-reference mirror pulled from Claude Design templates —
# reference only, never the app's own source of truth (see CLAUDE.md).
/HomevaultClaudeDesign/

# Figma design-reference export (Synology DSM 7 clone — Desktop/LOGIN/WIZARD).
# Reference assets only; the tokens they inspired live in tokens.css.
/figma_design/

# Ad-hoc verification screenshots dropped at the repo root by test/review
# passes — not build output, not docs; see CLAUDE.md's "keep the repo
# clean" rule.
/*.png
/*.jpg
/*.jpeg

# Generated type declaration emitted by Vite (build artifact).
/frontend/vite.config.d.ts

# AI-tool agent configs and local skill installs (not part of the build).
/.opencode/
/.agents/

# Generated by `npm run prebuild` (src/lib/icons/generate-sprite.mjs) and
# copied into static/dist by `vite build` — a build artifact, not a source.
/frontend/public/sprite-unified.svg

# Personal design-token reference (Apple-style spec). The rules it defines are
# recorded in frontend/src/lib/styles/theme/tokens.css and
# docs/guides/design-system.md §2.2; the document itself is not published.
/design-tokens.md
